{
  "name": "herbes-fraiches",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "test:ui": "playwright test",
    "test:ui:shared": "HERBES_E2E_SHARED=1 playwright test",
    "db:start": "SUPABASE_TELEMETRY_DISABLED=1 supabase start --eager -x storage,functions,studio,mail,analytics,pooler",
    "db:stop": "SUPABASE_TELEMETRY_DISABLED=1 supabase stop",
    "db:demo": "node scripts/setup-local.js",
    "dev:shared": "vite --mode shared --port 5174 --strictPort",
    "test:shared": "node scripts/check-shared.js",
    "build:pages": "node scripts/build-pages.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^6.0.0",
    "supabase": "^3.1.0",
    "vite": "^8.0.0"
  }
}
